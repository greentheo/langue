// Langue web — Postgres schema.
//
// Mirrors the concepts the Python CLI tracks in SQLite (users, per-language
// word exposure, activity log, achievements, flashcard reviews) and adds what a
// multi-user hosted app needs: password credentials, revocable sessions, and
// invite codes so the deployment stays closed to strangers.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts for CLI commands and
// reaches the runtime client via the pg driver adapter in src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

/// A registered learner. Registration requires a valid InviteCode.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Learning preferences.
  currentLanguage String @default("italian")
  currentLevel    String @default("a1")
  nativeLanguage  String @default("English")

  // Aggregate progress. Denormalized on purpose: the dashboard reads these on
  // every page load, and recomputing them from ActivityLog would not scale.
  points     Int @default(0)
  streakDays Int @default(0)

  /// Streak reminders sent since the learner last practised (lib/reminders.ts).
  reminderCount  Int       @default(0)
  lastRemindedAt DateTime?

  /// When the learner first saw the accent tip (#114): it shows once, ever.
  accentTipSeenAt DateTime?

  /// The invite code this account registered with. Null for accounts whose
  /// code was later deleted.
  inviteCodeId String?
  inviteCode   InviteCode? @relation("InviteMembers", fields: [inviteCodeId], references: [id], onDelete: SetNull)

  sessions     Session[]
  progress     LanguageProgress[]
  wordStats    WordStat[]
  activityLog  ActivityLog[]
  achievements Achievement[]
  reviews      FlashcardReview[]
  lessons      LessonProgress[]
  items        ItemProgress[]
  unitMarks    UnitMark[]
  groups       GroupMember[]
  pushSubscriptions PushSubscription[]
  events       Event[]
  invitesMade  InviteCode[]      @relation("InviteCreatedBy")

  @@index([email])
  @@index([inviteCodeId])
}

/// Server-side session. The cookie holds only a random token; revoking a
/// session means deleting the row, which a stateless JWT could not do.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userAgent String?
  /// When this session's admin last confirmed their password (#119): admin
  /// pages need it within 15 minutes. Cleared on switching in, on leaving the
  /// admin pages, and when an admin page is hidden.
  adminConfirmedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Registration code, good for `maxUses` accounts. Keeps the deployment
/// private and caps who can spend the owner's Anthropic budget.
model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  note        String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  /// How many accounts this code may create.
  maxUses     Int       @default(1)
  /// How many it has created. Only ever changed by the conditional increment in
  /// claimInviteUse, which refuses to go past maxUses.
  useCount    Int       @default(0)
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members     User[]    @relation("InviteMembers")
  /// Everyone on this code's leaderboard: who joined with it, who made it,
  /// and anyone who joined the group later with the code.
  groupMembers GroupMember[]

  @@index([code])
}

/// A learner in an invite code's group. Each code is a group with its own
/// leaderboard, and a learner can be in several: the code they signed up with,
/// codes they made, and codes they joined later from the leaderboard page.
model GroupMember {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviteCodeId String
  inviteCode   InviteCode @relation(fields: [inviteCodeId], references: [id], onDelete: Cascade)
  joinedAt     DateTime   @default(now())

  @@unique([userId, inviteCodeId])
  @@index([inviteCodeId])
}

/// Per-language progress for one user.
model LanguageProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language  String
  level     String   @default("a1")
  wordCount Int      @default(0)
  points    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, language])
  @@index([userId])
}

/// A word the user has encountered, with exposure count. Feeds both the
/// "words learned" metric and flashcard selection.
model WordStat {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   String
  word       String
  exposures  Int      @default(1)
  correct    Int      @default(0)
  incorrect  Int      @default(0)
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())
  /// Next scheduled review; null until the word has been graded at least once.
  dueAt      DateTime?
  /// SM-2 style interval in days and ease factor, for future spaced repetition.
  intervalDays Int   @default(0)
  ease         Float @default(2.5)

  @@unique([userId, language, word])
  @@index([userId, language])
  @@index([userId, language, dueAt])
}

/// One completed activity session.
model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityType String
  language     String
  level        String
  pointsEarned Int      @default(0)
  itemsTotal   Int      @default(0)
  itemsCorrect Int      @default(0)
  durationSec  Int      @default(0)
  completedAt  DateTime @default(now())
  metadata     Json?

  @@index([userId, completedAt])
  @@index([userId, activityType])
}

model Achievement {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  earnedAt DateTime @default(now())
  /// For a finished level: what its certificate prints (words, phrases, grammar,
  /// conversations), stored when it is awarded so it never changes (#91).
  detail   Json?

  @@unique([userId, name])
  @@index([userId])
}

/// Individual flashcard answer, kept for review history and grading analytics.
model FlashcardReview {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language   String
  level      String
  word       String
  expected   String
  userAnswer String
  score      Int
  correct    Boolean
  answeredAt DateTime @default(now())

  @@index([userId, language, answeredAt])
}

/// A learner's record for one lesson. Lessons live in the compiled curriculum
/// (data/curriculum), not the database, so lessonId is a curriculum id such as
/// "italian-a1-04-articles" rather than a foreign key.
model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  language    String
  level       String
  /// Best practice score so far, 0-100.
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  /// First time the learner scored at least the pass mark; null until then.
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, language, level])
}

/// One learnable item on the guided path — a word, a phrase, or a grammar
/// idea (a lesson section) — and how well this learner knows it. See
/// docs/guided-path.md for the stage ladder and review schedule.
model ItemProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language  String
  /// "w:italian:stanco", "p:italian-a1-cafe-3", "g:italian-a1-03-essere#2"
  itemKey   String
  kind      String
  /// 0 introduced · 1 recognises · 2 recalls · 3 produces · 4 uses · 5 says
  stage     Int      @default(0)
  /// The highest stage ever reached. Progress bars count this, so they
  /// never go down when an item fades.
  bestStage Int      @default(0)
  dueAt     DateTime @default(now())
  /// Days until the next review once the item is at the top stage.
  intervalDays Float @default(0)
  right     Int      @default(0)
  wrong     Int      @default(0)
  /// Consecutive right and consecutive wrong answers.
  rightStreak Int    @default(0)
  missStreak  Int    @default(0)
  tricky    Boolean  @default(false)
  introducedAt DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  @@unique([userId, itemKey])
  @@index([userId, language, dueAt])
}

/// The best a learner's progress in a guided-path unit has ever shown.
/// Adding words or ideas to a unit raises its item count, which would pull the
/// learner's bar down; the bar shows whichever is higher, so it never goes
/// backwards, and a unit once complete stays complete.
model UnitMark {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "italian-a1-3"
  unitId      String
  bestPercent Int       @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, unitId])
}

/// A phone or browser that agreed to streak reminders, for one learner. A
/// device shared by a family has a row per learner signed in on it, so one
/// "turn on" covers everyone, and each reminder says whose streak it is.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  p256dh    String
  auth      String
  /// The device's time zone ("Europe/Rome"), so reminders arrive in the evening there.
  timeZone  String?
  createdAt DateTime @default(now())

  @@unique([userId, endpoint])
  @@index([endpoint])
}

/// An in-house analytics event (#109). Nothing leaves the app and there are no
/// third parties. `props` holds ids, paths, counts, milliseconds and flags only:
/// lib/events/props.ts drops anything else, and never stores free text. No
/// visitor id is stored: whether a visit is a device's first today is worked
/// out in memory and kept as `firstToday` (lib/events/visitor.ts).
model Event {
  id     String   @id @default(cuid())
  /// The learner, for events in the app. Deleting the account deletes these.
  userId String?
  user   User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   String
  props  Json?
  at     DateTime @default(now())

  @@index([type, at])
  @@index([userId, at])
}
